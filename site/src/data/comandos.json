      "nome": "briefing",
      "ajuda": "mostra o briefing de um papel para uma tarefa",
      "usa_plano": true,
      "argumentos": [
        {
          "nome": "id",
          "obrigatorio": true,
          "recebe_valor": true,
          "padrao": null,
          "ajuda": null,
          "valores": null,
