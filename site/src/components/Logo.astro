---
// A logo do forge (D16): quatro fitas que fecham um triângulo, desenhadas pelo dono (public/images/logo.svg).
// A cor vem de `color` (currentColor), então o mesmo desenho serve na ferrugem, no ferro e no papel.
// Cada fita tem a sua classe (`fita-1` a `fita-4`) para a abertura da página inicial montá-las.

interface Props {
  /** Nome acessível. Sem ele, a logo é decorativa (aria-hidden), como ao lado da palavra "forge". */
  titulo?: string;
  class?: string;
}

const { titulo, class: classe } = Astro.props;
---

<svg
  class:list={['logo', classe]}
  viewBox="0 0 161 137"
  fill="currentColor"
  xmlns="http://www.w3.org/2000/svg"
  role={titulo ? 'img' : undefined}
  aria-label={titulo}
  aria-hidden={titulo ? undefined : 'true'}
  focusable="false"
>
  <path
    class="fita fita-1"
    d="M86.6396 64.0772L98.5462 84.7L147.002 112.676L160.59 136.211H56.886L78.8766 123.515H141.328L87.491 92.432L78.88 77.5173L86.6396 64.0772Z"
  ></path>
  <path
    class="fita fita-2"
    d="M79.6752 0L90.0782 18.0186L78.6319 24.6271L48.5043 76.8098L63.4725 102.736H76.3736L56.1653 114.403H41.2091L27.4169 90.514L79.6752 0Z"
  ></path>
  <path
    class="fita fita-3"
    d="M91.4788 20.9656L131.919 91.0098L127.837 98.0799L105.488 85.1767L109.611 78.0347L93.4342 50.0152L71.1056 88.6894L64.0349 92.7717L57.0282 80.6358L91.4788 20.9656Z"
  ></path>
  <path
    class="fita fita-4"
    d="M29.5261 104.912L35.288 114.892L21.5269 122.837H48.0631L80.883 103.889H93.5732L94.3532 102.538L119.735 117.192H82.6688L50.7884 135.598H0L11.8114 115.14L29.5261 104.912Z"
  ></path>
</svg>
